# ---------------------------------------------------------------------------
# Microsoft Foundry
# ---------------------------------------------------------------------------
# Foundry project endpoint, e.g. https://my-resource.services.ai.azure.com
# (A classic Azure OpenAI endpoint also works - set FOUNDRY_API_VERSION too.)
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
# Only needed for *.openai.azure.com endpoints:
FOUNDRY_API_VERSION=

# Fallback deployment for any villager without their own.
FOUNDRY_DEFAULT_DEPLOYMENT=gpt-5.4-mini
# Daily planning + reflection. ~20% of calls, but the highest leverage on
# behaviour - this is where villagers form beliefs about each other.
FOUNDRY_REFLECTION_DEPLOYMENT=gpt-6-luna
# Real embeddings for memory retrieval, requested at 256 dimensions to match
# the local fallback width. Leave blank to use the free hashing vector instead.
FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ---------------------------------------------------------------------------
# One deployment per villager - this is the fun part.
#
# Match model capability to how talkative the persona is. A small model given
# a terse character reads as in-character; given a scheming one it reads as
# broken. Orin and Tess are the manipulator and the interrogator, so they get
# the strong tier - the contrast against Sela's nano is the actual experiment.
#
# Every deployment appears exactly once, so the village doubles as a
# side-by-side comparison of all seven models under identical pressure.
# ---------------------------------------------------------------------------
FOUNDRY_DEPLOYMENT_SELA=gpt-5.4-nano    # farmer    - says little; nano reads as laconic, not dim
FOUNDRY_DEPLOYMENT_IVEN=gpt-5.4-mini    # clerk     - procedural, rule-following, cheap
FOUNDRY_DEPLOYMENT_DOV=gpt-5            # smith     - blunt; solid baseline to compare against
FOUNDRY_DEPLOYMENT_MARA=gpt-5.6-luna    # baker     - sharp, keeps a private ledger of grudges
FOUNDRY_DEPLOYMENT_ORIN=grok-4.7        # merchant  - irreverent; best voice for a hustler
FOUNDRY_DEPLOYMENT_TESS=gpt-6.1-sol     # archivist - strongest; interrogates and drives the plot

# ---------------------------------------------------------------------------
# Simulation
# ---------------------------------------------------------------------------
MOCK_LLM=false          # true = run the whole village with zero cloud calls
SECONDS_PER_TICK=2.0    # real seconds per tick
MINUTES_PER_TICK=10     # in-world minutes per tick
START_HOUR=7
MAX_CONCURRENT_LLM=4
DIALOGUE_TURNS=6
REFLECTION_THRESHOLD=40
RETRIEVAL_K=8
